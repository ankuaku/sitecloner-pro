# Port the app listens on
PORT=3000
# CHANGE THIS — password for /admin
ADMIN_PASSWORD=change-me-please
# Long random string used to sign admin cookies (any 32+ characters)
SESSION_SECRET=replace-with-a-long-random-string
# How many clones can run at the same time (each Smart clone uses one Chrome, ~250 MB RAM)
MAX_CONCURRENT=2
# Number of reverse proxies in front of the app (1 for Render/Nginx/Cloudflare)
TRUST_PROXY=1
# Keep false in production. true only for local testing against localhost sites.
ALLOW_PRIVATE_NETWORK=false
# Optional: path to a system Chrome/Chromium (set automatically in Docker)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Optional: send the browser through a proxy (helps when sites block your server IP)
# BROWSER_PROXY=http://user:pass@proxy-host:port
# Set true on 512 MB servers (Render free/starter). Slower, but keeps Chrome inside the memory limit.
# LOW_MEMORY=true
